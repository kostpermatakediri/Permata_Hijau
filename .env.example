# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon key atau publishable key (aman dipublish, dijaga RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role / secret key. JANGAN pakai prefix NEXT_PUBLIC. Hanya server.
SUPABASE_SERVICE_ROLE_KEY=

# --- Info kos (tampil di landing & halaman bayar) ---
NEXT_PUBLIC_KOS_NAME="Kos Putri Bu Kustrini"
NEXT_PUBLIC_SITE_URL=https://kos-contoh.vercel.app
# Nomor WA Bu Kus, format internasional tanpa + atau spasi
NEXT_PUBLIC_WA_NUMBER=6281234567890

# --- Info rekening untuk transfer ---
NEXT_PUBLIC_BANK_NAME=BCA
NEXT_PUBLIC_BANK_ACCOUNT=1234567890
NEXT_PUBLIC_BANK_HOLDER="Kustrini"

# --- Galon ---
NEXT_PUBLIC_GALON_PRICE=7000

# --- Cron (Vercel kirim header Authorization: Bearer <CRON_SECRET> otomatis) ---
CRON_SECRET=ganti-dengan-string-acak-panjang
